{
  "manifest_version": 3,
  "name": "Internship Copilot Autofill",
  "version": "1.0",
  "description": "Fills Greenhouse/Lever/Ashby/Workday applications from your Copilot profile.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.greenhouse.io/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.icims.com/*"
  ],
  "action": { "default_popup": "popup.html" }
}